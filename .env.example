# Copy to .env (git-ignored) and fill in what you need. Every key is optional:
# `make up` runs on the committed sample without any of them and pauses the DAGs that need one.

# EIA open data key (free: https://www.eia.gov/opendata/register.php).
# Needed for live extraction (eia_hourly, eia_daily_sweep DAGs; make extract-sample).
EIA_API_KEY=

# The assistant's model provider: bedrock (Claude on Amazon Bedrock, needs AWS credentials)
# or openai (temporary, ADR-0003). Leave empty to keep the nightly agent eval paused.
GRIDPULSE_AGENT_PROVIDER=
# Only for GRIDPULSE_AGENT_PROVIDER=openai.
GRIDPULSE_AGENT_OPENAI_API_KEY=

# Slack incoming webhook for task-failure alerts. Without it failures are only logged.
SLACK_WEBHOOK_URL=
